{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Racass/scripts_servidor/samba/nextcloud-state.schema.json",
  "title": "Estado de identidades Samba para Nextcloud",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "generation_id",
    "generated_at",
    "managed_groups",
    "groups",
    "users",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "role"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
        },
        "role": {
          "const": "ROLE_STANDALONE"
        }
      }
    },
    "generation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "managed_groups": {
      "const": [
        "samba-users",
        "samba-admin",
        "samba-laudos",
        "samba-laudos-mega",
        "samba-administrativo"
      ]
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samba-users",
        "samba-admin",
        "samba-laudos",
        "samba-laudos-mega",
        "samba-administrativo"
      ],
      "properties": {
        "samba-users": {
          "$ref": "#/$defs/userList"
        },
        "samba-admin": {
          "$ref": "#/$defs/userList"
        },
        "samba-laudos": {
          "$ref": "#/$defs/userList"
        },
        "samba-laudos-mega": {
          "$ref": "#/$defs/userList"
        },
        "samba-administrativo": {
          "$ref": "#/$defs/userList"
        }
      }
    },
    "users": {
      "$ref": "#/$defs/userList"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["users", "groups"],
      "properties": {
        "users": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "groups": {
          "const": 5
        }
      }
    }
  },
  "$defs": {
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z_][a-z0-9_-]*$",
      "not": {
        "const": "nextcloud_user"
      }
    },
    "userList": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/username"
      }
    }
  }
}

