#!/bin/bash

# ============================================================
# CRIAR USUÁRIO SAMBA
# Debian Fileserver
#
# Estrutura:
#
# /srv/files/
# ├── publico/
# ├── usuarios/
# │   ├── usuario1/
# │   └── usuario2/
# ├── laudos/
# │   └── mega/
# └── administrativo/
#
# Grupos:
#
# samba-users
#     -> acesso ao Publico
#     -> acesso à própria pasta em Usuarios
#
# samba-admin
#     -> acesso administrativo a tudo
#
# samba-laudos
#     -> acesso a /laudos
#
# samba-laudos-mega
#     -> acesso a /laudos/mega
#
# samba-administrativo
#     -> acesso a /administrativo
#
# ============================================================


# ============================================================
# MODO SEGURO DO BASH
# ============================================================

set -Eeuo pipefail


# ============================================================
# CONFIGURAÇÕES
# ============================================================

BASE="/srv/files"

PUBLIC="$BASE/publico"
USERS="$BASE/usuarios"
LAUDOS="$BASE/laudos"
LAUDOS_MEGA="$BASE/laudos/mega"
ADMINISTRATIVO="$BASE/administrativo"


# Grupos

GROUP_USERS="samba-users"
GROUP_ADMIN="samba-admin"
GROUP_LAUDOS="samba-laudos"
GROUP_LAUDOS_MEGA="samba-laudos-mega"
GROUP_ADMINISTRATIVO="samba-administrativo"


# Samba

SAMBA_CONF="/etc/samba/smb.conf"
SAMBA_FILES_CONF="/etc/samba/fileserver.conf"

BACKUP_DIR="/etc/samba/backup"


# Usuário atual

USERNAME=""


# Controle do rollback

USER_CREATED=0
SAMBA_CREATED=0
DIR_CREATED=0

MAIN_CONF_MODIFIED=0
FILES_CONF_CREATED=0

MAIN_BACKUP=""
FILES_BACKUP=""


# ============================================================
# CORES
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'


# ============================================================
# FUNÇÕES DE SAÍDA
# ============================================================

erro() {
    echo
    echo -e "${RED}ERRO: $1${NC}"
    echo
}


sucesso() {
    echo -e "${GREEN}$1${NC}"
}


aviso() {
    echo -e "${YELLOW}$1${NC}"
}


info() {
    echo -e "${BLUE}$1${NC}"
}


# ============================================================
# ROLLBACK
#
# Se qualquer etapa crítica falhar, tentamos desfazer somente
# aquilo que foi criado/modificado durante esta execução.
# ============================================================

rollback() {

    echo
    echo "============================================================"
    echo " ERRO DETECTADO - INICIANDO ROLLBACK"
    echo "============================================================"
    echo


    # --------------------------------------------------------
    # Restaurar smb.conf principal
    # --------------------------------------------------------

    if [ "$MAIN_CONF_MODIFIED" -eq 1 ] &&
       [ -n "$MAIN_BACKUP" ] &&
       [ -f "$MAIN_BACKUP" ]; then

        echo "Restaurando smb.conf principal..."

        cp "$MAIN_BACKUP" "$SAMBA_CONF" || true

    fi


    # --------------------------------------------------------
    # Restaurar fileserver.conf
    #
    # Se existia antes, restauramos.
    # Se não existia, removemos o arquivo criado.
    # --------------------------------------------------------

    if [ "$FILES_CONF_CREATED" -eq 1 ]; then

        if [ -n "$FILES_BACKUP" ] &&
           [ -f "$FILES_BACKUP" ]; then

            echo "Restaurando fileserver.conf..."

            cp "$FILES_BACKUP" "$SAMBA_FILES_CONF" || true

        else

            echo "Removendo fileserver.conf criado..."

            rm -f "$SAMBA_FILES_CONF" || true

        fi

    fi


    # --------------------------------------------------------
    # Remover usuário Samba
    # --------------------------------------------------------

    if [ "$SAMBA_CREATED" -eq 1 ]; then

        echo "Removendo usuário do Samba..."

        smbpasswd -x "$USERNAME" \
            >/dev/null 2>&1 || true

    fi


    # --------------------------------------------------------
    # Remover usuário Linux
    # --------------------------------------------------------

    if [ "$USER_CREATED" -eq 1 ]; then

        echo "Removendo usuário Linux..."

        userdel -r "$USERNAME" \
            >/dev/null 2>&1 || true

    fi


    # --------------------------------------------------------
    # Remover pasta pessoal
    # --------------------------------------------------------

    if [ "$DIR_CREATED" -eq 1 ]; then

        echo "Removendo diretório pessoal..."

        rm -rf "$USERS/$USERNAME" || true

    fi


    # --------------------------------------------------------
    # Reiniciar Samba com configuração anterior
    # --------------------------------------------------------

    systemctl restart smbd \
        >/dev/null 2>&1 || true


    echo
    echo "Rollback concluído."
    echo

}


# ============================================================
# TRATAMENTO GLOBAL DE ERRO
# ============================================================

on_error() {

    local EXIT_CODE=$?

    erro "Falha na linha $1."

    rollback

    exit "$EXIT_CODE"
}


trap 'on_error $LINENO' ERR


# ============================================================
# VERIFICAR ROOT
# ============================================================

if [ "$EUID" -ne 0 ]; then

    erro "Este script precisa ser executado como root."

    echo "Execute:"
    echo
    echo "  sudo ./criar_usuario_samba.sh"

    exit 1

fi


# ============================================================
# CABEÇALHO
# ============================================================

clear

echo
echo "============================================================"
echo "       CRIAÇÃO DE USUÁRIO - DEBIAN FILESERVER"
echo "============================================================"
echo


# ============================================================
# VERIFICAR DEPENDÊNCIAS
# ============================================================

echo "==> Verificando dependências..."

REQUIRED_COMMANDS=(
    "useradd"
    "usermod"
    "passwd"
    "smbpasswd"
    "testparm"
    "setfacl"
    "getfacl"
    "systemctl"
)


for COMMAND in "${REQUIRED_COMMANDS[@]}"; do

    if ! command -v "$COMMAND" >/dev/null 2>&1; then

        erro "Comando obrigatório não encontrado: $COMMAND"

        exit 1

    fi

done


sucesso "Dependências OK."


# ============================================================
# VERIFICAR GRUPOS
# ============================================================

echo
echo "==> Verificando grupos Samba..."

REQUIRED_GROUPS=(
    "$GROUP_USERS"
    "$GROUP_ADMIN"
    "$GROUP_LAUDOS"
    "$GROUP_LAUDOS_MEGA"
    "$GROUP_ADMINISTRATIVO"
)


for GROUP in "${REQUIRED_GROUPS[@]}"; do

    if ! getent group "$GROUP" >/dev/null 2>&1; then

        erro "Grupo obrigatório não existe: $GROUP"

        echo
        echo "Crie o grupo com:"
        echo
        echo "  groupadd $GROUP"
        echo

        exit 1

    fi

    echo "    OK: $GROUP"

done


# ============================================================
# VERIFICAR ESTRUTURA DE DIRETÓRIOS
# ============================================================

echo
echo "==> Verificando estrutura de diretórios..."

REQUIRED_DIRS=(
    "$PUBLIC"
    "$USERS"
    "$LAUDOS"
    "$LAUDOS_MEGA"
    "$ADMINISTRATIVO"
)


for DIRECTORY in "${REQUIRED_DIRS[@]}"; do

    if [ ! -d "$DIRECTORY" ]; then

        aviso "Diretório não existe: $DIRECTORY"

        echo "Criando..."

        mkdir -p "$DIRECTORY"

    fi

done


sucesso "Estrutura de diretórios OK."


# ============================================================
# FUNÇÃO PARA ADICIONAR GRUPO OPCIONAL
# ============================================================

adicionar_grupo_opcional() {

    local GROUP="$1"
    local DESCRIPTION="$2"


    echo

    read -rp \
        "Adicionar $USERNAME ao grupo $DESCRIPTION ($GROUP)? [s/N]: " \
        ADD_GROUP


    if [[ "$ADD_GROUP" =~ ^[Ss]$ ]]; then

        usermod -aG "$GROUP" "$USERNAME"

        echo
        sucesso "Usuário adicionado ao grupo $GROUP."

    else

        echo
        echo "Usuário NÃO será adicionado ao grupo $GROUP."

    fi

}


# ============================================================
# NOME DO USUÁRIO
# ============================================================

echo
echo "============================================================"
echo " NOVO USUÁRIO"
echo "============================================================"
echo

read -rp "Nome do novo usuário: " USERNAME


# ============================================================
# VALIDAR NOME
# ============================================================

if [ -z "$USERNAME" ]; then

    erro "Nome de usuário vazio."

    exit 1

fi


if [[ ! "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]]; then

    erro "Nome de usuário inválido."

    echo
    echo "Use somente:"
    echo "  letras minúsculas"
    echo "  números"
    echo "  _"
    echo "  -"
    echo

    exit 1

fi


# ============================================================
# VERIFICAR SE USUÁRIO JÁ EXISTE
# ============================================================

if id "$USERNAME" >/dev/null 2>&1; then

    erro "O usuário '$USERNAME' já existe."

    exit 1

fi


# ============================================================
# CRIAR USUÁRIO LINUX
# ============================================================

echo
echo "==> Criando usuário Linux..."

useradd \
    -m \
    -s /bin/bash \
    "$USERNAME"

USER_CREATED=1

sucesso "Usuário Linux criado."


# ============================================================
# SENHA LINUX
# ============================================================

echo
echo "==> Defina a senha do usuário Linux:"
echo

passwd "$USERNAME"


# ============================================================
# GRUPO BASE
# ============================================================

echo
echo "==> Adicionando usuário ao grupo obrigatório:"
echo
echo "    $GROUP_USERS"

usermod -aG "$GROUP_USERS" "$USERNAME"

sucesso "Usuário adicionado ao grupo $GROUP_USERS."


# ============================================================
# GRUPOS OPCIONAIS
# ============================================================

echo
echo "============================================================"
echo " GRUPOS OPCIONAIS"
echo "============================================================"


adicionar_grupo_opcional \
    "$GROUP_ADMIN" \
    "Administradores"


adicionar_grupo_opcional \
    "$GROUP_LAUDOS" \
    "Laudos"


adicionar_grupo_opcional \
    "$GROUP_LAUDOS_MEGA" \
    "Laudos Mega"


adicionar_grupo_opcional \
    "$GROUP_ADMINISTRATIVO" \
    "Administrativo"


# ============================================================
# SENHA SAMBA
# ============================================================

echo
echo "============================================================"
echo " SENHA DO SAMBA"
echo "============================================================"
echo

echo "Defina a senha que será utilizada no acesso Windows."
echo

smbpasswd -a "$USERNAME"

SAMBA_CREATED=1


echo
echo "==> Ativando usuário no Samba..."

smbpasswd -e "$USERNAME"

sucesso "Usuário Samba criado e ativado."


# ============================================================
# CRIAR DIRETÓRIO PESSOAL
# ============================================================

USER_DIR="$USERS/$USERNAME"


echo
echo "==> Criando diretório pessoal:"
echo
echo "    $USER_DIR"
echo


mkdir -p "$USER_DIR"

DIR_CREATED=1


# ============================================================
# PERMISSÕES DA PASTA PESSOAL
# ============================================================

echo
echo "==> Configurando permissões da pasta pessoal..."


# ------------------------------------------------------------
# Proprietário
# ------------------------------------------------------------

chown "$USERNAME:$GROUP_USERS" "$USER_DIR"


# ------------------------------------------------------------
# Permissões base
# ------------------------------------------------------------

chmod 0700 "$USER_DIR"


# ------------------------------------------------------------
# Usuário
# ------------------------------------------------------------

setfacl -m "u:$USERNAME:rwx" "$USER_DIR"


# ------------------------------------------------------------
# Administradores
# ------------------------------------------------------------

setfacl -m "g:$GROUP_ADMIN:rwx" "$USER_DIR"


# ------------------------------------------------------------
# Samba-users NÃO acessa pasta de outros usuários
# ------------------------------------------------------------

setfacl -m "g:$GROUP_USERS:---" "$USER_DIR"


# ------------------------------------------------------------
# Outros
# ------------------------------------------------------------

setfacl -m "o::---" "$USER_DIR"


# ============================================================
# ACL PADRÃO DA PASTA PESSOAL
# ============================================================

echo
echo "==> Configurando ACL padrão..."


setfacl -d -m "u::rwx" "$USER_DIR"

setfacl -d -m "g::---" "$USER_DIR"

setfacl -d -m "g:$GROUP_ADMIN:rwx" "$USER_DIR"

setfacl -d -m "o::---" "$USER_DIR"


# ============================================================
# BACKUP DO SAMBA
# ============================================================

echo
echo "============================================================"
echo " BACKUP DAS CONFIGURAÇÕES SAMBA"
echo "============================================================"
echo


mkdir -p "$BACKUP_DIR"


TIMESTAMP=$(date +"%Y%m%d-%H%M%S")


MAIN_BACKUP="$BACKUP_DIR/smb.conf.$TIMESTAMP"

FILES_BACKUP="$BACKUP_DIR/fileserver.conf.$TIMESTAMP"


# ------------------------------------------------------------
# Backup do smb.conf principal
# ------------------------------------------------------------

cp "$SAMBA_CONF" "$MAIN_BACKUP"

MAIN_CONF_MODIFIED=1

echo "Backup:"
echo "  $MAIN_BACKUP"


# ------------------------------------------------------------
# Backup do fileserver.conf, se existir
# ------------------------------------------------------------

if [ -f "$SAMBA_FILES_CONF" ]; then

    cp "$SAMBA_FILES_CONF" "$FILES_BACKUP"

    echo "Backup:"
    echo "  $FILES_BACKUP"

fi


# ============================================================
# GERAR CONFIGURAÇÃO DO FILESERVER
# ============================================================

echo
echo "==> Atualizando fileserver.conf..."


cat > "$SAMBA_FILES_CONF" <<EOF
# ============================================================
# Debian Fileserver
#
# Arquivo gerenciado por:
# criar_usuario_samba.sh
# ============================================================


[Publico]

    path = $PUBLIC

    browseable = yes
    read only = no

    valid users = +$GROUP_USERS +$GROUP_ADMIN

    force group = $GROUP_USERS

    create mask = 0660
    directory mask = 2770

    inherit permissions = yes
    inherit acls = yes


[Usuarios]

    path = $USERS

    browseable = yes
    read only = no

    valid users = +$GROUP_USERS +$GROUP_ADMIN

    force group = $GROUP_USERS

    create mask = 0660
    directory mask = 0770

    inherit permissions = yes
    inherit acls = yes

    hide unreadable = yes


[Laudos]

    path = $LAUDOS

    browseable = yes
    read only = no

    valid users = +$GROUP_LAUDOS +$GROUP_ADMIN

    force group = $GROUP_LAUDOS

    create mask = 0660
    directory mask = 2770

    inherit permissions = yes
    inherit acls = yes


[Laudos-Mega]

    path = $LAUDOS_MEGA

    browseable = yes
    read only = no

    valid users = +$GROUP_LAUDOS_MEGA +$GROUP_ADMIN

    force group = $GROUP_LAUDOS_MEGA

    create mask = 0660
    directory mask = 2770

    inherit permissions = yes
    inherit acls = yes


[Administrativo]

    path = $ADMINISTRATIVO

    browseable = yes
    read only = no

    valid users = +$GROUP_ADMINISTRATIVO +$GROUP_ADMIN

    force group = $GROUP_ADMINISTRATIVO

    create mask = 0660
    directory mask = 2770

    inherit permissions = yes
    inherit acls = yes

EOF


FILES_CONF_CREATED=1


# ============================================================
# GARANTIR INCLUDE NO SMB.CONF
# ============================================================

echo
echo "==> Verificando include no smb.conf principal..."


INCLUDE_LINE="include = $SAMBA_FILES_CONF"


if ! grep -Fqx "$INCLUDE_LINE" "$SAMBA_CONF"; then

    echo >> "$SAMBA_CONF"

    echo "# Debian Fileserver" >> "$SAMBA_CONF"

    echo "$INCLUDE_LINE" >> "$SAMBA_CONF"

    echo "Include adicionado."

else

    echo "Include já existe."

fi


# ============================================================
# VALIDAR CONFIGURAÇÃO SAMBA
# ============================================================

echo
echo "============================================================"
echo " VALIDANDO CONFIGURAÇÃO SAMBA"
echo "============================================================"
echo


if ! testparm -s "$SAMBA_CONF"; then

    erro "O testparm encontrou problemas na configuração Samba."

    rollback

    exit 1

fi


sucesso "Configuração Samba válida."


# ============================================================
# REINICIAR SAMBA
# ============================================================

echo
echo "==> Reiniciando Samba..."


if ! systemctl restart smbd; then

    erro "Falha ao reiniciar o serviço smbd."

    rollback

    exit 1

fi


# ============================================================
# VERIFICAR SERVIÇO
# ============================================================

echo
echo "==> Verificando serviço Samba..."


if ! systemctl is-active --quiet smbd; then

    erro "O serviço smbd não está ativo."

    rollback

    exit 1

fi


sucesso "Samba está ativo."


# ============================================================
# HABILITAR SAMBA NO BOOT
# ============================================================

systemctl enable smbd >/dev/null 2>&1 || true


# ============================================================
# MOSTRAR GRUPOS DO USUÁRIO
# ============================================================

echo
echo "============================================================"
echo " GRUPOS DO USUÁRIO"
echo "============================================================"
echo


id "$USERNAME"


# ============================================================
# MOSTRAR ACL
# ============================================================

echo
echo "============================================================"
echo " ACL DA PASTA PESSOAL"
echo "============================================================"
echo


getfacl "$USER_DIR"


# ============================================================
# RESUMO
# ============================================================

echo
echo "============================================================"
echo -e " ${GREEN}USUÁRIO CRIADO COM SUCESSO${NC}"
echo "============================================================"
echo

echo "Usuário Linux : $USERNAME"

echo
echo "Diretório:"
echo "  $USER_DIR"

echo
echo "Grupos:"
id -nG "$USERNAME"

echo
echo "Compartilhamentos disponíveis:"
echo
echo "  \\\\IP_DO_SERVIDOR\\Publico"
echo "  \\\\IP_DO_SERVIDOR\\Usuarios"
echo "  \\\\IP_DO_SERVIDOR\\Laudos"
echo "  \\\\IP_DO_SERVIDOR\\Laudos-Mega"
echo "  \\\\IP_DO_SERVIDOR\\Administrativo"

echo
echo "Regras:"
echo
echo "  Publico"
echo "    -> samba-users"
echo "    -> samba-admin"

echo
echo "  Usuarios/<usuario>"
echo "    -> próprio usuário"
echo "    -> samba-admin"

echo
echo "  Laudos"
echo "    -> samba-laudos"
echo "    -> samba-admin"

echo
echo "  Laudos-Mega"
echo "    -> samba-laudos-mega"
echo "    -> samba-admin"

echo
echo "  Administrativo"
echo "    -> samba-administrativo"
echo "    -> samba-admin"

echo
echo "Backup:"
echo "  $MAIN_BACKUP"

if [ -f "$FILES_BACKUP" ]; then
    echo "  $FILES_BACKUP"
fi

echo
echo "============================================================"
echo

exit 0
